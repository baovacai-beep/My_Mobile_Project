<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SSharing"
        tools:targetApi="31">

        <!-- Màn hình chính mặc định -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2 Màn hình của Lê Nguyễn Khánh Trình -->
        <activity
            android:name=".MapStoreLocatorActivity"
            android:exported="false" />
        <activity
            android:name=".VoucherDetailActivity"
            android:exported="false" />

        <!-- 2 Màn hình của Lê Bảo Ngọc -->
        <activity
            android:name=".WalletActivity"
            android:exported="false" />
        <activity
            android:name=".PostVoucherActivity"
            android:exported="false" />
        <!-- 3 Màn hình của Hồ Gia Bảo -->
        <activity
            android:name=".EscrowChatActivity"
            android:exported="false" />
        <activity
            android:name=".SellerDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

    </application>

</manifest>