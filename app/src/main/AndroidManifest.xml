<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền truy cập GPS, Camera và Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SSharing"
        tools:targetApi="31">

        <!-- API Key Google Maps SDK -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyA_DemoGoogleMapsApiKeySSharing2026" />

        <!-- Màn hình Đăng nhập (Màn hình khởi chạy bắt buộc) -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình chính -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Màn hình Trạm 0đ & Flash Grab -->
        <activity
            android:name=".ui.CommunityCouponsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.FlashGrabActivity"
            android:exported="false" />

        <!-- 2 Màn hình của Lê Nguyễn Khánh Trình -->
        <activity
            android:name=".ui.MapStoreLocatorActivity"
            android:exported="false" />
        <activity
            android:name=".ui.VoucherDetailActivity"
            android:exported="false" />

        <!-- 2 Màn hình của Lê Bảo Ngọc -->
        <activity
            android:name=".ui.WalletActivity"
            android:exported="false" />
        <activity
            android:name=".ui.PostVoucherActivity"
            android:exported="false" />
        <activity
            android:name=".ui.InstantBuybackActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CoinTopupActivity"
            android:exported="false" />
        <!-- 3 Màn hình của Hồ Gia Bảo -->
        <activity
            android:name=".ui.EscrowChatActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SellerDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ProfileActivity"
            android:exported="false" />
        <!-- 3 Màn hình mới của Bảo -->
        <activity
            android:name=".ui.TwoFactorAuthActivity"
            android:exported="false" />
        <activity
            android:name=".ui.EkycVerificationActivity"
            android:exported="false" />
        <activity
            android:name=".ui.DisputeClaimActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity_brand_mall"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.activity_staff_arbiter"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>