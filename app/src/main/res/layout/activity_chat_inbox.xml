<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0814">

    <!-- Top Toolbar -->
    <RelativeLayout
        android:id="@+id/layoutBarInbox"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#120E22"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBackChatInbox"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Quay lại"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Hộp Thoại &amp; Quản Lý Đoạn Chat"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnOpenP2PTrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_outline_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="Bàn Trade"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Header 4 Tabs Filter (Phân tách Rạch Ròi Chat Giao Dịch & Chat Bạn Bè) -->
    <LinearLayout
        android:id="@+id/layoutChatInboxTabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@id/layoutBarInbox"
        android:background="#161327"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabActiveEscrowChats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_active"
            android:gravity="center"
            android:text="🛒 Giao Dịch"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabSocialFriendChats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="💬 Bạn Bè"
            android:textColor="#888888"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabSupportChats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎧 CSKH"
            android:textColor="#888888"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabCompletedChats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📜 Lịch Sử"
            android:textColor="#888888"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutChatInboxTabs"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerChatConversations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Dynamic conversation list added via Java -->
        </LinearLayout>
    </ScrollView>
</RelativeLayout>