<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0A17"
    android:padding="16dp">

    <!-- 1. Header: Người giao dịch -->
    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Quay lại"
            android:padding="4dp"
            android:text="❮"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <FrameLayout
            android:id="@+id/framePartnerAvatarHeader"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:layout_toEndOf="@id/btnBack">

            <TextView
                android:id="@+id/tvAvatarUser"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_purple"
                android:gravity="center"
                android:text="MT"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgPartnerAvatarHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh đại diện đối tác"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/framePartnerAvatarHeader"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_partner_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minh Triết"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_partner_trust"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_chip_gold_dark"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="98% Uy tín  ★ 4.9"
                android:textColor="#F5A623"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnMoreOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Tùy chọn khác"
            android:padding="4dp"
            android:text="•••"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </RelativeLayout>

    <!-- 2. Thẻ trạng thái Ký quỹ Escrow (Sticky Header) -->
    <LinearLayout
        android:id="@+id/cardEscrowStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutHeader"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_dark"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_dark_purple"
                android:gravity="center"
                android:text="🔒"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Giao dịch trung gian an toàn (Escrow)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_escrow_holding_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đang tạm giữ: 1,500 SS"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_escrow_countdown_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ Còn lại 00:58:24 để thử mã"
                android:textColor="#FFA726"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Thẻ Voucher & Hộp mở mã bí mật -->
    <RelativeLayout
        android:id="@+id/cardVoucherInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardEscrowStatus"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card_dark"
        android:padding="12dp">

        <TextView
            android:id="@+id/icVoucher"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_badge_pink"
            android:gravity="center"
            android:text="🎟" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/btnCopyVoucherCode"
            android:layout_toEndOf="@id/icVoucher"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVoucherTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Shopee 50K - Điện tử"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSecretCodeDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Mã bí mật: SP50K-OCTOBER99"
                android:textColor="#6EE7B7"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCopyVoucherCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_outline_button"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="📋 Sao chép mã"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- 4. Khu vực cuộn Chat tin nhắn P2P -->
    <ScrollView
        android:id="@+id/scrollChatArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutBottomContainer"
        android:layout_below="@id/cardVoucherInfo"
        android:layout_marginVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerChatMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSystemNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:background="@drawable/bg_card_dark"
                android:gravity="center"
                android:padding="8dp"
                android:text="🛡️ Hệ thống: Người mua đã khóa 1,500 SS vào ví Escrow. Người mua có 60 phút để kiểm tra mã trước khi tiền giải ngân."
                android:textColor="#9E9AA9"
                android:textSize="11sp" />

            <!-- Tin nhắn Người bán -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_dark_purple"
                    android:gravity="center"
                    android:text="MT"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_bubble_seller"
                    android:maxWidth="260dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chào bạn, mã mình mới nhận sáng nay chưa dùng nhé!"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="4dp"
                        android:text="09:38"
                        android:textColor="#78718C"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tin nhắn Người mua -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_bubble_buyer"
                android:maxWidth="260dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ok để mình nhập thử vào Shopee xem được không."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="09:39 ✓✓"
                    android:textColor="#D1C4E9"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 5. Khung đáy -->
    <LinearLayout
        android:id="@+id/layoutBottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <!-- Ô soạn tin nhắn -->
        <LinearLayout
            android:id="@+id/layoutChatInputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_attach_image_chat"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input_field"
                android:contentDescription="Gửi ảnh"
                android:padding="12dp"
                android:src="@drawable/ic_document_file"
                app:tint="#815BF5" />

            <EditText
                android:id="@+id/et_chat_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="Nhập tin nhắn trao đổi..."
                android:importantForAutofill="no"
                android:inputType="textShortMessage"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6C638A"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btn_send_chat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_purple"
                android:contentDescription="Gửi tin nhắn"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- 2 Nút thao tác Ký quỹ -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmEscrow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_purple"
            android:text="✓ Xác nhận mã thành công (Giải phóng Xu)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReportEscrow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_btn_outline_pink"
            android:text="⚠ Báo cáo lỗi / Khiếu nại mã"
            android:textAllCaps="false"
            android:textColor="#FF4081"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>