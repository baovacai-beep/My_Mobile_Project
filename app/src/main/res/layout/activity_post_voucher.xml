<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0914">

    <!-- Header Toolbar -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Quay lại"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Đăng bán Voucher (OCR)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnInfo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Thông tin"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_info"
            app:tint="#FFFFFF" />
    </RelativeLayout>

    <!-- Nội dung cuộn -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomContainer"
        android:layout_below="@id/header"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Tải ảnh Voucher OCR viền đứt -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#161327"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <RelativeLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_dark_purple">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_centerInParent="true"
                            android:contentDescription="Icon tài liệu"
                            android:src="@drawable/ic_document_file"
                            app:tint="#815BF5" />
                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Tải ảnh Voucher bóc tách Smart OCR"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Chọn Hình Thức Bán / Tặng -->
            <RadioGroup
                android:id="@+id/rg_sell_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_field"
                android:orientation="horizontal"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/rb_sell_for_coin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Bán lấy Xu"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_donate_community"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tặng 0 Xu (Cộng Đồng)"
                    android:textColor="#43E5A0"
                    android:textSize="13sp" />
            </RadioGroup>

            <!-- Card Thông tin Voucher -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#161327"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/lblBrand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="THƯƠNG HIỆU"
                            android:textColor="#A09CAB"
                            android:textSize="11sp" />

                        <AutoCompleteTextView
                            android:id="@+id/etBrand"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblBrand"
                            android:layout_marginTop="2dp"
                            android:layout_toStartOf="@id/badgeFB"
                            android:background="@null"
                            android:completionThreshold="1"
                            android:hint="Thương hiệu (Ví dụ: Shopee, Grab, Tiki...)"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:minHeight="48dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#A09CAB"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badgeFB"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_badge_pink"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="F&amp;B"
                            android:textColor="#FF4D8D"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/lblCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MÃ VOUCHER"
                            android:textColor="#A09CAB"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblCode"
                            android:layout_marginTop="2dp"
                            android:layout_toStartOf="@id/iconsRightCode"
                            android:background="@null"
                            android:hint="Nhập mã voucher"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:minHeight="48dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#A09CAB"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/iconsRightCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="Xem mã"
                                android:padding="13dp"
                                android:src="@drawable/ic_eye"
                                app:tint="#FFFFFF" />

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="Sao chép"
                                android:padding="13dp"
                                android:src="@drawable/ic_copy"
                                app:tint="#FFFFFF" />
                        </LinearLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/lblDiscount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GIẢM GIÁ"
                            android:textColor="#A09CAB"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etDiscount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblDiscount"
                            android:layout_marginTop="2dp"
                            android:background="@null"
                            android:hint="Nhập giá giảm"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:minHeight="48dp"
                            android:textColor="#43E5A0"
                            android:textColorHint="#A09CAB"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/lblExpiry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HẠN DÙNG"
                            android:textColor="#A09CAB"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etExpiry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblExpiry"
                            android:layout_marginTop="2dp"
                            android:layout_toStartOf="@id/icCalendar"
                            android:background="@null"
                            android:hint="DD/MM/YYYY"
                            android:importantForAutofill="no"
                            android:inputType="date"
                            android:minHeight="48dp"
                            android:text="31/12/2026"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#A09CAB"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/icCalendar"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="Lịch"
                            android:padding="13dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="#FFFFFF" />
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card Thông tin bán hàng -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#161327"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Thông tin bán hàng"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/lblSellingPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giá bán mong muốn"
                            android:textColor="#A09CAB"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etSellingPrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblSellingPrice"
                            android:layout_marginTop="2dp"
                            android:layout_toStartOf="@id/chipSShares"
                            android:background="@null"
                            android:hint="0 SS"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:minHeight="48dp"
                            android:textColor="#43E5A0"
                            android:textColorHint="#A09CAB"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/chipSShares"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_chip_gold_dark"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="Xu SShares"
                                android:src="@drawable/ic_coin" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="SShares"
                                android:textColor="#E8B837"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/lblDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mô tả ngắn voucher"
                            android:textColor="#A09CAB"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblDescription"
                            android:layout_marginTop="6dp"
                            android:background="@null"
                            android:gravity="top"
                            android:hint="Nhập mô tả..."
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine"
                            android:minHeight="48dp"
                            android:minLines="3"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#A09CAB"
                            android:textSize="13sp" />
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#0B0914"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#815BF5"
            android:text="Đăng bán ngay"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>
</RelativeLayout>