<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardBannerItem"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:id="@+id/layoutBannerBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Full-Width Horizontal Promo Banner Image -->
        <ImageView
            android:id="@+id/imgFullBannerBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Banner khuyến mãi nhãn hàng"
            android:scaleType="centerCrop" />

        <!-- Bottom Translucent Dark Overlay for Text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#B30B0914"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBannerBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_dark"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="🔥 SIÊU DEAL SHOPEE FOOD"
                    android:textColor="#FFD54F"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBannerPriceSS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_pink"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="120 SS"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBannerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Giảm 50% đơn từ 100K khi thanh toán qua SSharing"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>