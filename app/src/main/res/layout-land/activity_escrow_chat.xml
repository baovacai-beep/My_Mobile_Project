<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0A17"
    android:orientation="horizontal"
    android:padding="12dp"
    android:weightSum="10">

    <!-- CỘT TRÁI (3.8 / 10) -->
    <LinearLayout
        android:id="@+id/layoutLeftLandPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3.8"
        android:background="@drawable/bg_card_dark"
        android:orientation="vertical"
        android:padding="12dp">

        <RelativeLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Quay lại"
                android:padding="4dp"
                android:text="❮"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvAvatarUser"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/btnBack"
                android:background="@drawable/bg_circle_purple"
                android:gravity="center"
                android:text="MT"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/tvAvatarUser"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_partner_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minh Triết"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_partner_trust"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_gold_dark"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="98% Uy tín"
                    android:textColor="#F5A623"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnMoreOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Tùy chọn khác"
                android:text="•••"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/cardEscrowStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#161325"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_escrow_holding_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 Đang tạm giữ: 1,500 SS"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_escrow_countdown_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="⏱ Còn lại 00:58:24 để thử mã"
                android:textColor="#FFA726"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardVoucherInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#161325"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvVoucherTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎟 Shopee 50K - Điện tử"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSecretCodeDisplay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mã: SP50K-OCTOBER99"
                    android:textColor="#6EE7B7"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCopyVoucherCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_outline_button"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:text="Copy"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmEscrow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_purple"
            android:text="✓ Xác nhận thành công"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReportEscrow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_btn_outline_pink"
            android:text="⚠ Báo cáo lỗi"
            android:textAllCaps="false"
            android:textColor="#FF4081"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CỘT PHẢI (6.2 / 10) -->
    <RelativeLayout
        android:id="@+id/layoutRightLandPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="6.2">

        <ScrollView
            android:id="@+id/scrollChatArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/layoutChatInputBar"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSystemNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="🛡️ Hệ thống: Tiền đang giữ an toàn trong ví Escrow."
                    android:textColor="#9E9AA9"
                    android:textSize="10sp" />

                <!-- Tin nhắn Người bán -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_circle_dark_purple"
                        android:gravity="center"
                        android:text="MT"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_bubble_seller"
                        android:maxWidth="320dp"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chào bạn, mã mình mới nhận sáng nay chưa dùng nhé!"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="2dp"
                            android:text="09:38"
                            android:textColor="#78718C"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Tin nhắn Người mua -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_bubble_buyer"
                    android:maxWidth="320dp"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ok để mình nhập thử vào Shopee xem được không."
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="2dp"
                        android:text="09:39 ✓✓"
                        android:textColor="#D1C4E9"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/layoutChatInputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_chat_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="Nhập tin nhắn..."
                android:inputType="textShortMessage"
                android:importantForAutofill="no"
                android:paddingHorizontal="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6C638A"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btn_send_chat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_purple"
                android:contentDescription="Gửi tin nhắn"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>